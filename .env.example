# Langfuse 
LANGFUSE_PUBLIC_KEY=pk_xxxxxx
LANGFUSE_SECRET_KEY=sk_xxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_SERVICE_NAME=your-service-api
OTEL_RESOURCE_ATTRIBUTES=service.version=0.1.1,deployment.environment=dev

# LLM provider
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=300